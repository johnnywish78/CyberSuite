{
  "name": "johnny-cybersuite-x",
  "version": "3.7.1",
  "description": "Johnny CyberSuite X \u2014 All In One Network & System Dashboard",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --linux deb AppImage",
    "postbuild": "sudo ./scripts/fix-sandbox.sh"
  },
  "author": {
    "name": "Johnny Wish",
    "email": "johnnywish78@gmail.com"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.johnny.cybersuite",
    "productName": "Johnny CyberSuite X",
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "themes.json",
        "to": "themes.json"
      },
      {
        "from": "theme_assets.json",
        "to": "theme_assets.json"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "johnny-cybersuite-x"
    }
  }
}
